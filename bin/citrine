#!/usr/bin/env ruby
# frozen_string_literal: true

# lib 入 $LOAD_PATH：dev_server/packager 里的裸 require（citrine/theme 等同库文件）
# 走标准解析，与 rake t.libs / gem 安装后的行为一致
$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

# Citrine CLI
#   citrine dev [目录] [-p 端口]      启动开发服务器（热刷新）
#   citrine package <示例名>          打包为 macOS .app（桌面化）
require_relative "../lib/citrine/dev_server"
require_relative "../lib/citrine/packager"

cmd = ARGV.shift
case cmd
when "dev"
  Citrine::DevServer.run!(ARGV)
when "package"
  Citrine::Packager.run!(ARGV)
when nil, "help", "-h", "--help"
  puts <<~USAGE
    Citrine（工作代号）CLI

    用法:
      bin/citrine dev [目录] [-p 端口]   开发服务器：改 .rb 自动编译并刷新浏览器
                                     目录默认 examples，端口默认 4402
                                     -I 追加加载路径（可重复），跨仓库示例用
      bin/citrine package <示例名>       打包为 macOS .app（build/ 目录下）
                                     如: bin/citrine package counter

    桌面开发模式:
      bin/citrine dev & 后执行:
      build/CitrineCounter.app/Contents/MacOS/CitrineCounter --dev http://localhost:4402/counter.html
  USAGE
else
  warn "未知命令: #{cmd}（试试 bin/citrine help）"
  exit 1
end

